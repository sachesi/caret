[Desktop Entry]
Name=Tangent
GenericName=Terminal
Comment=Use the command line
Exec=tangent
Icon=io.github.sachesi.tangent
Terminal=false
Type=Application
Categories=GTK;System;TerminalEmulator;
StartupNotify=true
Keywords=shell;prompt;command;commandline;console;
Actions=new-window;
X-TerminalArgExec=-e
X-TerminalArgDir=--working-directory

[Desktop Action new-window]
Name=New Window
Exec=tangent
