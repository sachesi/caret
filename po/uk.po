msgid "Tangent"
msgstr "Tangent"

#: data/io.github.sachesi.tangent.desktop:3 ui/shortcuts_dialog.ui:90
msgid "Terminal"
msgstr "Термінал"

#: data/io.github.sachesi.tangent.desktop:4
#: data/io.github.sachesi.tangent.metainfo.xml:7
msgid "Use the command line"
msgstr "Робота з командним рядком"

#: data/io.github.sachesi.tangent.desktop:11
msgid "shell;prompt;command;commandline;console;"
msgstr "оболонка;запрошення;команда;командний рядок;консоль;shell;prompt;command;commandline;console;"

#: data/io.github.sachesi.tangent.desktop:17 ui/shortcuts_dialog.ui:15
msgid "New Window"
msgstr "Нове вікно"

#: data/io.github.sachesi.tangent.gschema.xml:16 src/preferences.rs:52
#, no-c-format
msgid "Font"
msgstr "Шрифт"

#: data/io.github.sachesi.tangent.gschema.xml:17
msgid "A Pango font description such as “Monospace 11”; empty for the desktop's monospace font."
msgstr "Опис шрифту Pango, наприклад «Monospace 11»; порожнє значення — моноширинний шрифт стільниці."

#: data/io.github.sachesi.tangent.gschema.xml:21
msgid "Light or dark"
msgstr "Світлий чи темний"

#: data/io.github.sachesi.tangent.gschema.xml:22
msgid "“system” follows the desktop's preference."
msgstr "«system» слідує налаштуванню стільниці."

#: data/io.github.sachesi.tangent.gschema.xml:26
msgid "Cursor shape"
msgstr "Форма курсора"

#: data/io.github.sachesi.tangent.gschema.xml:27
msgid "The shape of the cursor until a program asks for another."
msgstr "Форма курсора, доки програма не попросить іншу."

#: data/io.github.sachesi.tangent.gschema.xml:32
msgid "Lines of history"
msgstr "Рядків історії"

#: data/io.github.sachesi.tangent.gschema.xml:33
msgid "How many lines that scrolled off the top are kept to scroll back to."
msgstr "Скільки рядків, що пішли за верхній край, зберігається для прокручування назад."

#: data/io.github.sachesi.tangent.gschema.xml:37
msgid "Custom command"
msgstr "Власна команда"

#: data/io.github.sachesi.tangent.gschema.xml:38
msgid "A command line that tabs run instead of the shell, split into words the way the shell does; empty for the shell."
msgstr "Командний рядок, який вкладки запускають замість оболонки, поділений на слова так само, як це робить оболонка; порожній рядок означає оболонку."

#: data/io.github.sachesi.tangent.gschema.xml:42
msgid "Scroll on output"
msgstr "Прокручування під час виведення"

#: data/io.github.sachesi.tangent.gschema.xml:43
msgid "Whether output brings a view scrolled back into the history to the bottom."
msgstr "Чи повертає виведення програми вниз вигляд, прокручений в історію."

#: data/io.github.sachesi.tangent.gschema.xml:47
msgid "Scroll on keystroke"
msgstr "Прокручування під час натискання клавіш"

#: data/io.github.sachesi.tangent.gschema.xml:48
msgid "Whether typing or pasting brings a view scrolled back into the history to the bottom."
msgstr "Чи повертає введення або вставлення вниз вигляд, прокручений в історію."

#: data/io.github.sachesi.tangent.gschema.xml:52
msgid "Terminal bell"
msgstr "Дзвінок термінала"

#: data/io.github.sachesi.tangent.gschema.xml:53
msgid "Whether the bell a program rings makes a sound. A tab in the background is marked either way."
msgstr "Чи звучить дзвінок, поданий програмою. Фонова вкладка позначається в будь-якому разі."

#: data/io.github.sachesi.tangent.gschema.xml:57
msgid "Title bar"
msgstr "Заголовок вікна"

#: data/io.github.sachesi.tangent.gschema.xml:58
msgid "Whether windows show the title bar. Without it, the context menu has its commands."
msgstr "Чи показувати заголовок вікна. Без нього його команди є в контекстному меню."

#: data/io.github.sachesi.tangent.gschema.xml:62
msgid "Window size"
msgstr "Розмір вікна"

#: data/io.github.sachesi.tangent.gschema.xml:63
msgid "The size of new windows; 0 fits 80 columns by 24 lines of the font."
msgstr "Розмір нових вікон; 0 — 80 стовпців на 24 рядки шрифту."

#: data/io.github.sachesi.tangent.gschema.xml:67
msgid "Window maximized"
msgstr "Вікно розгорнуте"

#: data/io.github.sachesi.tangent.metainfo.xml:9
msgid "Tangent is a terminal built with GTK 4 and libadwaita. Its text is drawn by the GPU, pixel for pixel at any display scale."
msgstr "Tangent — термінал на GTK 4 і libadwaita. Його текст малює графічний процесор, піксель у піксель за будь-якого масштабу екрана."

#: data/io.github.sachesi.tangent.metainfo.xml:11
msgid "Tabs with an overview, and new tabs and windows in the folder of the current one"
msgstr "Вкладки з оглядом; нові вкладки й вікна відкриваються в теці поточної"

#: data/io.github.sachesi.tangent.metainfo.xml:12
msgid "Search through the history, selection by word or line, and addresses opened with Ctrl and a click"
msgstr "Пошук в історії, виділення словами й рядками, адреси відкриваються клацанням із Ctrl"

#: data/io.github.sachesi.tangent.metainfo.xml:13
msgid "Mouse reporting, bracketed paste, true colour, and underline styles"
msgstr "Передавання подій миші, вставлення в дужках, повнокольоровий режим і стилі підкреслення"

#: data/io.github.sachesi.tangent.metainfo.xml:14
msgid "The desktop's monospace font and colour scheme, or ones of its own"
msgstr "Моноширинний шрифт і колірна схема стільниці або власні"

#: data/io.github.sachesi.tangent.metainfo.xml:21
msgid "sachesi"
msgstr "sachesi"

#: data/io.github.sachesi.tangent.metainfo.xml:33
msgid "The first release."
msgstr "Перший випуск."

