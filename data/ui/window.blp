using Gtk 4.0;
using Adw 1;

menu primary_menu {
  section {
    item {
      label: _("New _Window");
      action: "app.new-window";
    }

    item {
      label: _("New _Tab");
      action: "win.new-tab";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Tangent");
      action: "app.about";
    }
  }
}

template $TangentWindow: Adw.ApplicationWindow {
  width-request: 360;
  height-request: 294;
  title: _("Tangent");

  // The tab button and the overview are enough where the bar would be cramped.
  Adw.Breakpoint {
    condition ("max-width: 500sp")

    setters {
      tab_bar.visible: false;
    }
  }

  content: Adw.TabOverview tab_overview {
    view: tab_view;
    enable-new-tab: true;
    create-tab => $on_create_tab() swapped;

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar header_bar {
        [start]
        Button {
          icon-name: "tab-new-symbolic";
          tooltip-text: _("New Tab");
          action-name: "win.new-tab";
        }

        title-widget: Adw.WindowTitle window_title {
          title: _("Tangent");
        };

        [end]
        MenuButton {
          icon-name: "open-menu-symbolic";
          menu-model: primary_menu;
          primary: true;
          tooltip-text: _("Main Menu");
        }

        [end]
        Adw.TabButton {
          view: tab_view;
          action-name: "overview.open";
        }

        [end]
        ToggleButton {
          icon-name: "edit-find-symbolic";
          tooltip-text: _("Find");
          active: bind search_bar.search-mode-enabled bidirectional;
        }
      }

      [top]
      Adw.TabBar tab_bar {
        view: tab_view;
        autohide: true;
      }

      [top]
      SearchBar search_bar {
        notify::search-mode-enabled => $on_search_mode() swapped;

        child: Adw.Clamp {
          maximum-size: 500;

          child: Box {
            spacing: 6;

            SearchEntry search_entry {
              hexpand: true;
              placeholder-text: _("Find in the history");
              search-changed => $on_search_changed() swapped;
              activate => $on_search_up() swapped;
              next-match => $on_search_up() swapped;
              previous-match => $on_search_down() swapped;
              stop-search => $on_stop_search() swapped;
            }

            Box {
              styles [
                "linked",
              ]

              Button {
                icon-name: "go-up-symbolic";
                tooltip-text: _("Find Upwards");
                clicked => $on_search_up() swapped;
              }

              Button {
                icon-name: "go-down-symbolic";
                tooltip-text: _("Find Downwards");
                clicked => $on_search_down() swapped;
              }
            }
          };
        };
      }

      content: Adw.ToastOverlay {
        child: Adw.TabView tab_view {
          vexpand: true;
          close-page => $on_close_page() swapped;
          create-window => $on_create_window() swapped;
          notify::selected-page => $on_selected_page() swapped;
          notify::n-pages => $on_n_pages() swapped;
        };
      };
    };
  };
}
