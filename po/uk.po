msgid_plural ""
"{count} programs are still running in this window and will be stopped."
msgstr[0] "У цьому вікні ще працює {count} програма, її роботу буде перервано."
msgstr[1] ""
"У цьому вікні ще працюють {count} програми, їхню роботу буде перервано."
msgstr[2] ""
"У цьому вікні ще працюють {count} програм, їхню роботу буде перервано."

